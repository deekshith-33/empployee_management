{
  "info": {
    "name": "Employee Management API",
    "description": "Complete Postman collection for Auth, RBAC, and Employee CRUD with pagination, filtering, sorting, and search.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": "{{base_url}}/users/register"
          }
        },
        {
          "name": "Login (Auto-Saves JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "user@example.com", "type": "text" },
                { "key": "password", "value": "StrongPass123", "type": "text" }
              ]
            },
            "url": "{{base_url}}/users/login"
          }
        },
        {
          "name": "Get Current User (/users/me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{base_url}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List Employees (Paginated, Filtered, Sorted)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{base_url}}/employees/?page=1&limit=10&sort_by=salary&order=desc"
          }
        },
        {
          "name": "Get Employee by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{base_url}}/employees/1"
          }
        },
        {
          "name": "Create Employee (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Rohan\",\n  \"last_name\": \"Desai\",\n  \"email\": \"rohan.desai@company.com\",\n  \"salary\": 68000,\n  \"department_id\": 1\n}"
            },
            "url": "{{base_url}}/employees/"
          }
        },
        {
          "name": "Update Employee (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salary\": 74000\n}"
            },
            "url": "{{base_url}}/employees/1"
          }
        },
        {
          "name": "Delete Employee (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": "{{base_url}}/employees/1"
          }
        }
      ]
    }
  ]
}